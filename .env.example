# Application
APP_NAME=voice-agent
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# Browser frontend origins (KAN-16). Comma-separated, or * .
# Defaults in non-production: http://localhost:5173,http://localhost:5174
# CORS_ORIGINS=http://localhost:5174

# Database (local docker compose)
DATABASE_URL=postgresql://voice:voice@localhost:5432/voice_agent

# AI / LLM (optional until integration is wired)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-key-here

# Speech-to-Text — browser POC (optional until integration is wired)
# STT_PROVIDER=openai
# STT_MODEL=whisper-1
# STT_API_KEY=sk-your-key-here

# Text-to-Speech — browser POC (optional until integration is wired)
# TTS_PROVIDER=openai
# TTS_MODEL=tts-1
# TTS_API_KEY=sk-your-key-here

# RAG / vector database (local Qdrant from docker compose)
VECTOR_DB_URL=http://localhost:6333
# VECTOR_DB_API_KEY=  # not required for local Qdrant
EMBEDDING_MODEL=text-embedding-3-small
