    {
      "name": "STT",
      "item": [
        {
          "name": "POST /api/stt/transcribe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audioBase64\": \"AQID\",\n  \"mimeType\": \"audio/webm\",\n  \"fileName\": \"clip.webm\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/stt/transcribe",
            "description": "Convert browser-captured audio to text (KAN-11).\n\nReplace `audioBase64` with a real base64 audio clip for a live success run."
          },
          "response": [
            {
              "name": "Success — 200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"audioBase64\": \"<base64-audio>\",\n  \"mimeType\": \"audio/webm\",\n  \"fileName\": \"clip.webm\"\n}"
                },
                "url": "{{baseUrl}}/api/stt/transcribe"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"text\": \"I would like to book an appointment\"\n}"
            },
            {
              "name": "Fail — 400 VALIDATION_ERROR",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{}"
                },
                "url": "{{baseUrl}}/api/stt/transcribe"
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"audioBase64 is required\"\n  }\n}"
            },
            {
              "name": "Fail — 502 EXTERNAL_SERVICE_UNAVAILABLE",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"audioBase64\": \"AQID\",\n  \"mimeType\": \"audio/webm\"\n}"
                },
                "url": "{{baseUrl}}/api/stt/transcribe"
              },
              "status": "Bad Gateway",
              "code": 502,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"error\": {\n    \"code\": \"EXTERNAL_SERVICE_UNAVAILABLE\",\n    \"message\": \"Speech-to-text provider is unavailable\"\n  }\n}"
            }
          ]
        }
